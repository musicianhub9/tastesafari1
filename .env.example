# Required for production
FLASK_SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# First-run admin only (ignored once an admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Set to 1 when served over HTTPS
FLASK_SECURE_COOKIES=1

# Optional upload limits in bytes
MAX_IMAGE_BYTES=12582912
MAX_VIDEO_BYTES=524288000
